<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% render 'meta-tags' %}
    {% render 'lf-fonts' %}
    {{ 'critical.css' | asset_url | stylesheet_tag }}
    {{ 'lf-tokens.css' | asset_url | stylesheet_tag }}
    <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="{{ 'favicon-180.png' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body>
    {% sections 'header-group' %}
    <main id="lf-main" data-barba="wrapper">
      <div data-barba="container" data-barba-namespace="{{ template.name }}">{{ content_for_layout }}</div>
    </main>
    {% sections 'footer-group' %}
    {% section 'lf-cart-drawer' %}
    <div id="lf-blackout" aria-hidden="true"></div>
    <script>
      // Motion vendors load after first paint (not `defer`, which still competes
      // for main-thread time during initial parse) — this was Lighthouse mobile
      // perf's #1 cost on the motion layer (~170KB of GSAP-family JS). Sequential
      // load preserves execution order: each script depends on globals the
      // previous one sets (gsap before its plugins, lf-sections before lf-motion).
      (function () {
        var urls = [
          {{ 'gsap.min.js' | asset_url | json }},
          {{ 'ScrollTrigger.min.js' | asset_url | json }},
          {{ 'SplitText.min.js' | asset_url | json }},
          {{ 'Observer.min.js' | asset_url | json }},
          {{ 'barba.min.js' | asset_url | json }},
          {{ 'lenis.min.js' | asset_url | json }},
          {{ 'lf-sections.js' | asset_url | json }},
          {{ 'lf-motion.js' | asset_url | json }}
        ];
        function loadNext(i) {
          if (i >= urls.length) return;
          var s = document.createElement('script');
          s.src = urls[i];
          s.onload = function () { loadNext(i + 1); };
          s.onerror = function () { loadNext(i + 1); };
          document.body.appendChild(s);
        }
        function start() { loadNext(0); }
        if (document.readyState === 'complete') { start(); }
        else { window.addEventListener('load', start); }
      })();
    </script>
  </body>
</html>
